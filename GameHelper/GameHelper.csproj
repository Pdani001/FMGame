<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PackageId>FMGame.GameHelper</PackageId>
    <Title>FMGame.GameHelper</Title>
    <AssemblyName>$(Title)</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Pdani</Authors>
    <Product>$(Title)</Product>
    <Description>Helper classes for Fazbear Multiplayer</Description>
    <Copyright>$(Authors)</Copyright>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Gum.MonoGame" Version="2025.12.28.1" />
    <PackageReference Include="MonoGame.Extended" Version="5.3.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Network\Network.csproj" />
  </ItemGroup>

</Project>
